      }
    ]
  },
  {
    "@id": "https://biomedit.ch/rdf/sphn-resource/ed71b45b-966d-455d-87e4-6f6357a252a8",
    "@type": [
      "http://www.w3.org/2006/vcard/ns#Individual"
