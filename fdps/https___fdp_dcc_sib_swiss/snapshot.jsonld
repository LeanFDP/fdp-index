      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "The SPHN Federated Clinical Routine Dataset consists of standardized and semantically encoded clinical data available in the SPHN format at participating hospitals. Currently, it includes data from six Swiss hospitals. The dataset covers patients with a clinical case since 2018 who have signed the general consent. Each hospital retains its data locally and publishes corresponding metadata in the SPHN Metadata Catalog for discoverability. For research projects, subsets of this dataset can be requested through the respective hospital-specific governance processes."
      }
    ],
