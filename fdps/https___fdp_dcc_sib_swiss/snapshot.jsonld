    "http://purl.org/dc/terms/alternative": [
      {
        "@value": "SwissPedGrowth"
      }
    ],
    "http://purl.org/dc/terms/conformsTo": [
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sphn/2025/1"
      },
      {
        "@id": "http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The SwissPedGrowth dataset is a comprehensive collection of routinely gathered pediatric clinical data from participating Swiss children's hospitals. It includes anthropometric measurements (height, weight, head circumference), clinical parameters, and laboratory values obtained from both inpatient and outpatient visits. Data are collected from January 2017 to December 2025 and are enriched with socioeconomic information (Swiss-SEP) via linkages with federal datasets (Swiss National Cohort, FSO). This pseudonymized datasetâexcluding patients who rejected general consentâaims to use multi-institutional pediatric EHR data from Switzerland (SwissPedHealth) and compare them internationally to assess the feasibility of retrieving anthropometric data from EHRs in Switzerland, investigate data quality and validity, and answer simple research questions."
      }
    ],
    "http://purl.org/dc/terms/identifier": [
