        "@id": "https://schemascope.dcc.sib.swiss/?project=ADONIS&version=2024.1&dataset=retrospective-cohort"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasConsentType": [
      {
        "@value": "Informed Consent Waiver (Art. 34 HRA)"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasDataProvider": [
      {
        "@id": "_:n2dfc07f1f2fe4078921201e6c177c04fb6"
