  {
    "@id": "_:nc6905414a758462497d23ac75699ee69b1",
    "@type": [
      "http://xmlns.com/foaf/0.1/Agent"
    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/88f8fde4-aff4-5c05-919c-2edba893bcd7",
    "@type": [
      "http://www.w3.org/ns/dcat#Catalog",
