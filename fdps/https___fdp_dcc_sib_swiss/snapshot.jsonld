      {
        "@value": "Clinical Routine"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasDataUseRestriction": [
      {
        "@value": "In accordance with a Data Governance Working Group strategy considering institutional data governance and researchers' interest in compliance with Swiss legal and ethical regulations. Access is given upon approval of the Data Givernance Commission Insel Gruppe, directorate of research at Inselgruppe AG. Contact Point: Forschungssupport.DLF@insel.ch"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasExclusionCriteria": [
      {
        "@value": "The exclusion criteria that were applied for excluding patients from the project. These are specific characteristics or attributes of members of the target population which render them unsuitable to contribute data to the project. For the observational study 'Prediction of postoperative infections by strategic data imputation and explainable machine learning', the data from patients with a documented rejection for the use of healthcare data were excluded."
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasFundingOrganization": [
      {
        "@id": "_:n09fcda9f07f94c5e9f5c831a82117391b4"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "The inclusion criteria that were applied for including patients as viable data points into the project. These are specific characteristics or attributes that members of the target population must possess such that their data can be considered for the project. While the goal was to build a generalisable semantic layer in our cDWH, we didn't restrict the inclusion, but tried to integrate a broad patient cohort to represent the comprehensive Insel patient cohort. All valid patients records available in the Insel Data Platform with a discharge between 2020-01-01 - 2024-12-31 were included into the project-specific data mart in order to build a project-specific ontology and test the validation rules. For the observational study 'Prediction of postoperative infections by strategic data imputation and explainable machine learning', a data set of  91,794 patient cases with surgeries recorded in the Bern University Hospital from May 2014 to September 2022 was analysed, Inclusion criteria: Presence of a surgical procedure and at least one laboratory value in the first 30 days after surgery. For the Data Driven Diagnosis Sepsis Cohort, the cases of the patients treated at Insel Group 2020-01-01 - 2024-12-31 were used for the calculation of the SOFA and Phoenix score."
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasPrincipalInvestigator": [
      {
        "@value": "Olga Endrich"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasProjectPartner": [
      {
        "@id": "_:n09fcda9f07f94c5e9f5c831a82117391b5"
      },
