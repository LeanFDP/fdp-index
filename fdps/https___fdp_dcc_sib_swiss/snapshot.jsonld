      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "Enrolled in SPAC for the SPAC data, or patients who visited the pneumology clinics between the period and at the age described above and did neither participate in the SPAC study nor refuse the general consent for the non-SPAC data."
      }
