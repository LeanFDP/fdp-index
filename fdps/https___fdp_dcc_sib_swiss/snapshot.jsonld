      {
        "@id": "http://fdp.dcc.sib.swiss/profile/a0949e72-4466-4d53-8900-9436d1049a4b"
      },
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/spo/2025/1"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "http://fdp.dcc.sib.swiss/catalog/88f8fde4-aff4-5c05-919c-2edba893bcd7"
