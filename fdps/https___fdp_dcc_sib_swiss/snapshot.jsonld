    "http://semanticscience.org/resource/SIO_000628": [
      {
        "@id": "http://fdp.dcc.sib.swiss/catalog/087d497a-6f23-564d-a77a-a989a4df5d67/metrics/445c0a70d1e214e545b261559e2842f4"
