      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/distribution/aa38f756-7f57-5575-b144-ec4b040c95bb/metrics/5d27e854a9e78eb3f663331cd47cdc13",
