    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasExclusionCriteria": [
      {
        "@value": "Overall criteria: patients treated for multiple cancers"
      },
      {
        "@value": "Melanoma-specific criteria: Uveal melanoma (ICD-10 C69)"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "Melanoma-specific criteria: ICD-10 code C43 or diagnosis text contains 'melanoma|melanom|melanome', treated with anti-PD-1 based or anti-PDL-1 based therapies"
      },
      {
        "@value": "Breast cancer-specific criteria: ICD-10 code C50 or text contains âmammakarzinom', case insensitive, treated with either CDK inhibitors (ATC codes L01EF) or anti PD-1/PD-L1-based therapies (L01FF) or trastuzumab deruxtecan (L01FD04) or datopotamab deruxtecan (L01FX35) or sacituzumab govitecan (L01FX17) or trastuzuman emtanisne (L01XC14, L01FD03), metastatic"
      },
      {
        "@value": "CRC-specific criteria: ICD-10 code C18, C19 or C20, or German diagnosis text contains 'Dickdarmkrebs|Krebs des Dickdarms|Coecumkarzinom|Ascendenskarzinom|Transversumkarzinom|Descendenskarzinom|Kolonkarzinom|Sigmakarzinom|Karzinom des rektosigmoidalen Ãbergangs|Rektumkarzinom|Mastdarmkrebs|Enddarmkrebs', or French diagnosis text contains 'carcinome|cancer|adenoCa|adenoCa' and 'cÃ¦cal|caecal|caecum|cÃ¦cum|colique|colon|colon|rectal|rectum|sigmoid|sigmoÃ¯d', all case insensitive, stage IV (metastatic), treated with any systemic antineoplastic therapy (ATC code L01)"
      },
      {
        "@value": "NSCLC-specific criteria: note of NSCLC in German diagnosis text, which is one of 'NSCLC|Lungadenom|Lungenadenokarzinom|bronchioloalveolares Karzinom|bronchoalveolares Karzinom|PEC der Lunge|LCNEC', or one of 'bronchial|bronchialkarzinom|bronchus|lunge|lungenkarzinom|lungenkrebs|lungenmalignom|lungentumor|pulmonal|thorakal' together with one of 'adenokarzinom|adenosquamoses karzinom|epidermoidkarzinom|(groÃzellige|grosszellige) (karzinom|krebs|tumor)|karzinoid|nichtkleinzellige|nichtkleinzellige|nicht-kleinzellige|plattenepithel (karzinom|krebs|tumor)|pleomorphes karzinom|riesenzellkarzinom|Sarkomatoides karzinom|spindelzellkarzinom', or in French diagnosis note, which is one of 'NSCLC|carcinome bronchioloalveolaire|carcinome broncho-alveolaire', or one of 'bronchique|bronche|poumon|pulmonaire|thoracique|lobe |lobaire|lobulaire' together with one of 'adenocarcinome|adenome|carcinome adenosquameux|carcinome epidermoÃ¯de|carcinome spinocellulaire|(carcinome|cancer|tumeur) (grandes cellules|cellules geantes|non Ã  petites cellules)|carcinome pleomorphe|carcinome sarcomatoÃ¯de|carcinome Ã  cellules fusiformes', all case insensitive and all possibilities entailed by German declension and inflection considered, stage IV (metastatic)"
      },
      {
        "@value": "treated with anti-PD1 or anti-PDL1 based therapies"
      },
      {
        "@value": "Overall criteria: age at first date (incidence datetime) of diagnosis older than 18 years, approval of general consent, treated within the university hospital, biopsy assessed by NGS, date of NGS on or after 1st of January 2015"
      }
    ],
