  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/9070fe40-3c99-5efe-8f50-9ef01b081273",
    "@type": [
      "http://www.w3.org/ns/dcat#Catalog",
      "http://www.w3.org/ns/dcat#Resource"
    ],
    "http://data.europa.eu/r5r/applicableLegislation": [
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/617/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2022/491/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/642/de"
      },
      {
        "@value": "Cantonal data protection laws"
      }
    ],
    "http://healthdataportal.eu/ns/health#maxTypicalAge": [
      {
        "@value": 20
      }
    ],
    "http://healthdataportal.eu/ns/health#minTypicalAge": [
      {
        "@value": 0
      }
    ],
    "http://healthdataportal.eu/ns/health#numberOfUniqueIndividuals": [
      {
        "@value": 7779
      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "Lung function tests (LFT) are key diagnostic and outcome measures for lung diseases (e.g. asthma, ex-preterm, cystic fibrosis), but test result retrieval, quality control, and documentation are manual. Research projects that use routine data from EHRs are hampered by excessive manual work. This NP will 1) identify priority LFT elements, 2) develop appropriate approaches for collecting, harmonizing and integrating these elements into the SPHN clinical data warehouse (CDW) infrastructure and 3) transfer standardized LFT results from clinical data warehouses (CDW) to BioMedIT."
      }
    ],
    "http://purl.org/dc/terms/accessRights": [
      {
        "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
      }
    ],
    "http://purl.org/dc/terms/conformsTo": [
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sphn/2025/1"
      },
      {
        "@id": "http://fdp.dcc.sib.swiss/profile/a0949e72-4466-4d53-8900-9436d1049a4b"
      },
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sph/2025/1"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "http://fdp.dcc.sib.swiss/catalog/9070fe40-3c99-5efe-8f50-9ef01b081273"
      }
    ],
    "http://purl.org/dc/terms/isPartOf": [
