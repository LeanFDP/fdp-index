      }
    ],
    "http://purl.org/dc/terms/isReferencedBy": [
      {
        "@id": "https://doi.org/10.1016/j.arcped.2024.10.003"
      },
      {
        "@id": "https://doi.org/10.1038/s41390-025-04159-x"
