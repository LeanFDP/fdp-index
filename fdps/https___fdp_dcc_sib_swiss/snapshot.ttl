    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dcterms:alternative "MOMIC-Phase3-Phenotypes" ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604>,
        <https://www.biomedit.ch/rdf/sphn-schema/sph/2025/1> ;
    dcterms:description "Phase 3: Development of a multi-omics work-flow to discover rare diseases in children with extreme phenotypes. This study is a national multi-center prospective cohort study of n=140 patients aged from birth up to 20 years with extreme phenotypes admitted or referred to Swiss Children's Hospitals.We will obtain written consent and assent (if applicable) for all subjects taking part. We will collect blood samples from patients at presentation, alongside with routine clinical tests, and a skin biopsy. We will perform a buccal swab to patient's parents and siblings." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/d4ad525a-8fb0-5d01-87db-4495e3e5adfb" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0> ;
    dcterms:issued "2026-09-23T21:17:07"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:modified "2026-09-23T21:17:07"^^xsd:dateTime ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#HealthcareInformationSystem>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#ResearchLaboratory> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2025-09-01"^^xsd:date ;
