    dcterms:title "Manually Collected Clinical Data and Questionnaire Data for SPAC Participants" ;
    ns4:SIO_000628 <http://fdp.dcc.sib.swiss/dataset/12876005-f8d2-5edc-9216-f2ba2a3a5118/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/dataset/12876005-f8d2-5edc-9216-f2ba2a3a5118/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/0cf93bfe-4e38-4ee6-b925-589a9bb0ee01> ;
    dcat:distribution <http://fdp.dcc.sib.swiss/distribution/d8e20a6a-7853-5e7d-b084-2fe0d46fd91e> ;
    dcat:theme <https://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:version "1.0" ;
    ns1:hasConsentType "Project Informed Consent" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "Institute of Social and Preventive Medicine, University of Bern" ;
            foaf:homepage <https://www.ispm.unibe.ch> ] ;
    ns1:hasDataType "Clinical Routine",
        "Longitudinal",
        "PROMs" ;
    ns1:hasDataUseRestriction "Reuse of data of SPHN-SPAC is described in the SPHN-SPAC Data Project Consortium Agreement. Briefly, data may be shared under the prerequisites listed in the SwissPedHealth General Terms and Conditions (GTC), if they meet the following conditions: 1. the Project Executive Board must approve the sharing the data, 2. If the data includes personal information, each person or group that provided the data must give their individual, written consent, 3. Only parties or third parties who have signed an agreement with all project members (and approved by the Project Executive Board) can access the data.4. The sharing of data must follow all relevant laws, particularly those about human research and data usage, 5. The data cannot be used for profit or commercial purposes, 6. If required by law, the sharing must have approval from ethical committees or other relevant authorities. Contact point: claudia.kuehni@unibe.ch." ;
    ns1:hasInclusionCriteria "Enrolled in SPAC study during the above period through the pneumology clinics at Insel Gruppe AG, University of Bern Children's Hospital, University Children's Hospital Zurich - Eleonore Foundation and Luzerner Kantonspital" ;
    ns1:hasRatioOfSexes "1.53" ;
    ns1:hasStudyType "Retrospective Observational Study" ;
