<http://fdp.dcc.sib.swiss/catalog/e6aba0ba-7f6a-5013-93bf-b8cf1f3631cc> a dcat:Catalog,
        dcat:Resource ;
    rdfs:label "SwissPedHealth Nested Project 2: Improving Registration and Data Flows to and From The Swiss Childhood Cancer Registry (SwissPedCancer)" ;
    ns5:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,
        "Cantonal data protection laws" ;
    ns3:maxTypicalAge 20 ;
    ns3:minTypicalAge 0 ;
    ns3:numberOfUniqueIndividuals 667882 ;
    dcterms:abstract "SwissPedCancer aims to assess quality of EHRs and registry data, with the goal to optimize data flows to and from the Swiss Childhood Cancer Registry (ChCR). SwissPedCancer is an audit and quality improvement project and as such does not fall under the Human Research Act, Art. 2, para. 1. The SwissPedCancer project has been exempted from acquiring ethical waiver by the ethics committees (Req-2023-01081, KEK Bern). SwissPedCancer will cover years before (2017-2019) and after (2020-2023) the Cancer Registration Act (CRA) became into force, to enable a quality comparison over time." ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
