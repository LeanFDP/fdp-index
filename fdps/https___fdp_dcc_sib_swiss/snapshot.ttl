<http://fdp.dcc.sib.swiss/catalog/0cb87ed8-5159-53cf-b68e-639a9f95a443> a dcat:Catalog,
        dcat:Resource ;
    rdfs:label "Optimising paediatric dosing regimens based on a clinical data warehouse (SwissPedDW)" ;
    ns5:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,
        "Cantonal data protection laws" ;
    ns3:numberOfUniqueIndividuals 1419 ;
    dcterms:abstract "In our previous SPHN infrastructure project SwissPKcdw, we successfully established a clinical data warehouse (CDW) to enhance access to clinical data of pediatric patients cared for at the University Children's Hospital Zurich (Kispi) and Basel (UKBB). We collected and pseudonymized drug plasma concentrations from routine drug monitoring together with the respective clinical information. These data were analyzed by population pharmacokinetic modelling to identify factors (e.g., age, weight, endogenous metabolites) which influence or correlate with the fate of a particular drug in the body. The resulting models allow to optimize and individualize drug dosage regimens. In the current demonstrator project, we aim to expand the previously built infrastructure to the remaining university children's hospitals in Switzerland. In addition to the drug plasma concentrations and clinical information we will include data on relevant genes involved in the metabolism of the drugs and on molecules that give information on chemical processes within the cells. These data will allow searching for additional endogenous metabolites with predictive potential for the pharmacokinetics of a drug in pediatric patients." ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/a0949e72-4466-4d53-8900-9436d1049a4b>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/2024/2> ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/catalog/0cb87ed8-5159-53cf-b68e-639a9f95a443" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss> ;
    dcterms:isReferencedBy <https://doi.org/10.1002/psp4.12723>,
        <https://doi.org/10.3390/pharmaceutics13101596>,
        <https://doi.org/10.3390/pharmaceutics16010013> ;
    dcterms:issued "2026-10-16T09:31:27.743876+00:00"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
