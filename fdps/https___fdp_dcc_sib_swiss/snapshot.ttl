            foaf:homepage <https://www.kispi.uzh.ch> ] ;
    ns1:hasDataType "Phenotypic" ;
    ns1:hasDataUseRestriction "Samples and data of children with extreme phenotypes in Phase 2 arise from existing cohorts where consent to perform omics in stored biospecimens are already available. Conditions for data reuse must be determined with the cohort's responsible PI (not within SwissPedHealth)" ;
    ns1:hasExclusionCriteria "Samples excluded for which a documented refusal of further use is available." ;
