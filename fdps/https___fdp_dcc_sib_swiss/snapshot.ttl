        <http://fdp.dcc.sib.swiss/dataset/8de36f97-d98a-531e-a2a5-421df8646742/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/3cfa2622-a5be-41ff-8688-84a196929070>,
        <https://biomedit.ch/rdf/sphn-resource/97afff0a-3ad1-4a8d-8533-d10a8a36b55d>,
